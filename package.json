{
  "name": "ai-news-discussion",
  "version": "1.0.0",
  "description": "Web app for RSS news with AI discussion via Meterless and Zetaris storage",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "npm --prefix client start",
    "build": "npm --prefix client run build",
    "test:provider": "node --test server/providers/meterless-runtime.test.js",
    "verify:provider": "node scripts/verify-meterless-provider.cjs",
    "install-all": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "rss-parser": "^3.13.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  }
}
