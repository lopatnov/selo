{
  "name": "ai-news-discussion-tests",
  "version": "1.0.0",
  "description": "Integration tests for AI News Discussion Platform",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:providers": "playwright test --config playwright.providers.config.js",
