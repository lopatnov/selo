# ============================================================
# ZETARIS PLATFORM CONFIGURATION
# ============================================================
# Images (from Zetaris platform distribution)
DRIVER_IMAGE=zetarishackathon.azurecr.io/zetaris-ndp-driver:2.4.3-v2.4.3.1-hackathon.cb88df0b255aba5a9a9eda96483fc877cc82df80
API_IMAGE=zetarishackathon.azurecr.io/zetaris-ndp-api:2.4.3-v2.4.3.1-hackathon.a2848d8a41fa21673a0d719deb41b675412710fe
UI_IMAGE=zetarishackathon.azurecr.io/zetaris-new-ui:2.4.3-v2.4.3.1-hackathon.88e49b0db015979a2d071d2d68a6865d38a39f15

# Administrator account (set before first startup)
ZETARIS_ADMIN_EMAIL=admin@zetaris.com
ZETARIS_ADMIN_PASSWORD=Zetaris1@
ZETARIS_ADMIN_ORG=zetaris

# PostgreSQL (metastore)
POSTGRES_USER=zetaris
POSTGRES_PASSWORD=zt-metastore-6f2a9c41d0b7

# Spark/Driver sizing
ZSPARK_DRIVER_MEM=2g
ZSPARK_DRIVER_CORES=2
ZSPARK_MASTER_URL=local[2]
ZETARIS_API_MAX_HEAP=1g

# Network ports
# If a standalone zetaris-platform stack already runs on 3000/8888/8889,
# keep these on free ports for this compose project.
UI_PORT=3010
ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3002
GUI_URL=http://localhost:3010
API_PORT=8898
API_INTERNAL_PORT=8899
DRIVER_PORT=10000
SPARK_UI_PORT=4040
QUERY_HTTP_PUBLISH=0

# Compose profiles (leave empty for local)
COMPOSE_PROFILES=

# Sample data
ZETARIS_SEED_TPCH=true

# Telemetry
TELEMETRY_KEY=2E59B16F-F24A-427C-90A6-8F5652B7E280
TELEMETRY_ENABLED=
TELEMETRY_URL=https://cloud-api.enterprise.zetaris.com/api/v1.0/hackathon
TELEMETRY_INTERVAL_MINUTES=120

# ============================================================
# OUR APPLICATION CONFIGURATION
# ============================================================

# Meterless AI Configuration (hosted endpoint for non meterless/* model ids)
METERLESS_API_URL=https://api.meterless.ai/v1
METERLESS_API_KEY=your_meterless_api_key_here

# Meterless Runtime provider (local OpenAI-compatible runtime)
# Requires Meterless Runtime 1.4+. The UI can change all of these at runtime.
METERLESS_APP_ID=ai-news-discussion
METERLESS_STATE_DIR=
METERLESS_BASE_URL=http://127.0.0.1:8088/v1

# Zetaris API Key (create in Zetaris GUI after startup)
ZETARIS_API_KEY=your_zetaris_api_key_here

# Server config
PORT=3001
NODE_ENV=production